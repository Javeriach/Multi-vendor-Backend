# Local dev: discrete connection fields.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=eshop_marketplace

# Managed Postgres (Neon, Render, etc.): set this instead and the discrete
# fields above are ignored. Get it from your provider's dashboard.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

NODE_ENV=development
PORT=4000

# Frontend origin allowed to send credentialed requests (cookies).
CORS_ORIGIN=http://localhost:3000

# Used to build links back to the frontend (Stripe checkout success/cancel
# redirect URLs). Should match CORS_ORIGIN in most setups.
FRONTEND_URL=http://localhost:3000

# Generate a real secret for non-dev environments, e.g.: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Stripe (test mode keys during development — never commit real secrets)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
