DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=eshop_marketplace
NODE_ENV=development
PORT=4000

# Frontend origin allowed to send credentialed requests (cookies).
CORS_ORIGIN=http://localhost:3000

# Generate a real secret for non-dev environments, e.g.: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Stripe (test mode keys during development — never commit real secrets)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
